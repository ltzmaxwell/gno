# Storing a caller's tree makes the storing realm its owner; the caller's kept
# reference is a view. A `maketx run` script hands its tree to a keeper, which
# adopts it, then tries to write through the reference it kept. The adopter
# never granted, so the write is refused.

loadpkg gno.land/p/nt/avl/v0

adduser alice 100000000ugnot

gnoland start

gnokey maketx addpkg -pkgdir $WORK/keeper -pkgpath gno.land/r/test/keeper -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test alice
stdout OK!

! gnokey maketx run -gas-fee 1000000ugnot -gas-wanted 20000000 -broadcast -chainid=tendermint_test alice $WORK/run/main.gno
stderr 'call a function of the owning realm'

gnokey query vm/qrender --data 'gno.land/r/test/keeper:'
stdout 'stored=false'

-- keeper/gnomod.toml --
module = "gno.land/r/test/keeper"
gno = "0.9"

-- keeper/keeper.gno --
package keeper

import "gno.land/p/nt/avl/v0"

var stored *avl.Tree

func Store(cur realm, t *avl.Tree) { stored = t }

func Render(string) string {
	if stored == nil {
		return "stored=false"
	}
	v, _ := stored.Get("k").(string)
	return "stored=true k=" + v
}

-- run/main.gno --
package main

import (
	"gno.land/p/nt/avl/v0"
	"gno.land/r/test/keeper"
)

func main(cur realm) {
	t := avl.NewTree()
	keeper.Store(cross(cur), t)    // keeper adopts t: it is the owner now
	t.Set("k", "pwned")            // refused: t is keeper's, and keeper never granted
}
