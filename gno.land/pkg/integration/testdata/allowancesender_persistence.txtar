# Tests gno.land/p/jaekwon/allowancesender/v0 end-to-end and pins
# down both the working semantics AND the structural limitation
# discovered during integration.
#
# WORKS (the supported pattern):
#   - granter creates *AllowanceSender and hands the callee a function
#     literal written in its own source that calls Send; the callee uses
#     the literal WITHIN THE CALL.
#   - granter's defer al.Close() runs successfully.
#   - cap-exceeded and negative-amount inputs are rejected.
#
# The sender object is readable wherever it travels, but /p/ code cannot
# write it on the callee's behalf, so only the granter's own literal can
# spend. Phase 4 persists the object itself and Close still works home.

loadpkg gno.land/p/jaekwon/allowancesender/v0
loadpkg gno.land/r/test/callee $WORK/callee
loadpkg gno.land/r/test/granter $WORK/granter

adduserfrom user1 'source bonus chronic canvas draft south burst lottery vacant surface solve popular case indicate oppose farm nothing bullet exhibit title speed wink action roast' 1
stdout 'g18e22n23g462drp4pyszyl6e6mwxkaylthgeeq4'

gnoland start

# ============================================================
# Phase 1: in-call spending happy path
# ============================================================
# granter creates 500_000 ugnot allowance, callee spends 200_000
# during the call, granter's defer closes after. Funds move via
# the inner banker; allowance correctly tracks spent.
gnokey maketx call -pkgpath gno.land/r/test/granter -func GrantAndSpend -args 500000 -args 200000 -send 500000ugnot -gas-fee 1000000ugnot -gas-wanted 4100000 -chainid=tendermint_test user1
stdout OK!

# ============================================================
# Phase 2: cap-exceeded rejection
# ============================================================
# granter creates 100_000 cap, callee tries to spend 200_000.
# Wrapper rejects with "cap exceeded".
! gnokey maketx call -pkgpath gno.land/r/test/granter -func GrantAndSpend -args 100000 -args 200000 -send 100000ugnot -gas-fee 1000000ugnot -gas-wanted 10000000 -chainid=tendermint_test user1
stderr 'cap exceeded'

# ============================================================
# Phase 3: negative-amount rejection
# ============================================================
# callee constructs a negative chain.Coin and passes to Send.
# Wrapper rejects with "negative amount not allowed".
! gnokey maketx call -pkgpath gno.land/r/test/granter -func GrantAndSpendNegative -send 100000ugnot -gas-fee 1000000ugnot -gas-wanted 10000000 -chainid=tendermint_test user1
stderr 'negative amount not allowed'

# ============================================================
# Phase 4: persistence-by-callee + defer-Close kill switch
# ============================================================
# granter creates allowance, callee keeps a reference via
# `stored = al`, granter's defer al.Close() still succeeds: Close is
# the granter's own call on an object the granter allocated, so its
# write is the granter's. The callee's reference lets it read, not write.
gnokey maketx call -pkgpath gno.land/r/test/granter -func GrantAndStore -send 1000000ugnot -gas-fee 1000000ugnot -gas-wanted 4500000 -chainid=tendermint_test user1
stdout OK!

-- callee/gnomod.toml --
module = "gno.land/r/test/callee"
gno = "0.9"

-- callee/callee.gno --
package callee

import (
	"chain"

	"gno.land/p/jaekwon/allowancesender/v0"
)

// stored shows that callee can keep a reference to the granter's sender;
// the granter can still Close it (Phase 4), and the callee cannot spend
// through it (allowancesender_handoff.txtar).
var stored *allowancesender.AllowanceSender

// Store keeps a reference to the granter's sender. It gives the callee read
// access only; spending needs the granter's own function (allowancesender_handoff.txtar).
func Store(cur realm, al *allowancesender.AllowanceSender) {
	stored = al
}

// SpendTo is the supported within-call pattern: callee uses the
// allowance during the cross call without persisting.
func SpendTo(cur realm, spend func(address, chain.Coins), to address, amount int64) {
	spend(to, chain.NewCoins(chain.NewCoin("ugnot", amount)))
}

// SpendNegative exercises the negative-amount panic path.
func SpendNegative(cur realm, spend func(address, chain.Coins), to address) {
	spend(to, chain.Coins{chain.Coin{Denom: "ugnot", Amount: -50}})
}

-- granter/gnomod.toml --
module = "gno.land/r/test/granter"
gno = "0.9"

-- granter/granter.gno --
package granter

import (
	"chain"
	"chain/banker"
	"chain/runtime/unsafe"

	"gno.land/p/jaekwon/allowancesender/v0"

	"gno.land/r/test/callee"
)

// GrantAndSpend creates an allowance with `limit` cap, lets callee
// spend `amount` to the original caller, then closes via defer.
// Supported within-call pattern.
func GrantAndSpend(cur realm, limit int64, amount int64) {
	// Acknowledge the provisioning envelope; MsgCall rejects an
	// envelope no executing code ever observes.
	_ = unsafe.OriginSend()
	src := banker.NewBanker(banker.BankerTypeRealmSend, cur)
	al := allowancesender.New(src,
		unsafe.CurrentRealm().Address(),
		chain.NewCoins(chain.NewCoin("ugnot", limit)))
	defer al.Close()

	caller := unsafe.PreviousRealm().Address()
	spend := func(to address, amt chain.Coins) { al.Send(to, amt) }
	callee.SpendTo(cross(cur), spend, caller, amount)
}

// GrantAndSpendNegative exercises the negative-amount path.
func GrantAndSpendNegative(cur realm) {
	// Acknowledge the provisioning envelope; MsgCall rejects an
	// envelope no executing code ever observes.
	_ = unsafe.OriginSend()
	src := banker.NewBanker(banker.BankerTypeRealmSend, cur)
	al := allowancesender.New(src,
		unsafe.CurrentRealm().Address(),
		chain.NewCoins(chain.NewCoin("ugnot", 100000)))
	defer al.Close()

	caller := unsafe.PreviousRealm().Address()
	spend := func(to address, amt chain.Coins) { al.Send(to, amt) }
	callee.SpendNegative(cross(cur), spend, caller)
}

// GrantAndStore: callee keeps a reference to the sender; granter's
// deferred Close still runs, because the granter owns the object.
func GrantAndStore(cur realm) {
	// Acknowledge the provisioning envelope; MsgCall rejects an
	// envelope no executing code ever observes.
	_ = unsafe.OriginSend()
	src := banker.NewBanker(banker.BankerTypeRealmSend, cur)
	al := allowancesender.New(src,
		unsafe.CurrentRealm().Address(),
		chain.NewCoins(chain.NewCoin("ugnot", 1000000)))
	defer al.Close()

	callee.Store(cross(cur), al)
}
