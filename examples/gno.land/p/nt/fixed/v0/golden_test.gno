func TestGoldenMul(t *testing.T) {
	for _, tt := range goldenMul {
		if got := MustParse(tt.a).Mul(MustParse(tt.b)).String(); got != tt.want {
			t.Errorf("%s * %s = %s, want %s", tt.a, tt.b, got, tt.want)
		}
	}
}

func TestGoldenDiv(t *testing.T) {
	for _, tt := range goldenDiv {
		if got := MustParse(tt.a).Div(MustParse(tt.b)).String(); got != tt.want {
			t.Errorf("%s / %s = %s, want %s", tt.a, tt.b, got, tt.want)
		}
	}
}

func TestGoldenSqrt(t *testing.T) {
	for _, tt := range goldenSqrt {
		if got := MustParse(tt.in).Sqrt().String(); got != tt.want {
			t.Errorf("sqrt(%s) = %s, want %s", tt.in, got, tt.want)
		}
	}
}
